// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformUserRole {
  SUPER_ADMIN
  SUPPORT_ADMIN
}

model PlatformUser {
  id             Int              @id @default(autoincrement())
  email          String           @unique
  passwordHash   String
  role           PlatformUserRole @default(SUPER_ADMIN)
  isActive       Boolean          @default(true)
  createdTenants Tenant[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("platform_users")
}

enum SubscriptionPlan {
  Basic
  Pro
  Premium
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

model BrandMaster {
  id        Int    @id @default(autoincrement())
  brandCode String @unique
  brandName String

  models   VehicleModelMaster[]
  vehicles Vehicle[]
  fitment  PartFitment[]
  // variants  VehicleVariantMaster[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("BrandMaster")
}

enum CarBodyType {
  HATCHBACK
  MICRO_HATCHBACK
  PREMIUM_HATCHBACK
  MICROCAR

  SEDAN
  COMPACT_SEDAN
  NOTCHBACK
  FASTBACK
  LIFTBACK

  SUV
  SUBCOMPACT_SUV
  COMPACT_SUV
  MID_SIZE_SUV
  FULL_SIZE_SUV
  CROSSOVER
  COUPE_SUV
  OFF_ROAD_SUV
  LUXURY_SUV

  MPV
  MINIVAN
  MICROVAN
  PASSENGER_VAN

  COUPE
  CONVERTIBLE
  ROADSTER
  SPYDER
  TARGA
  STATION_WAGON
  ESTATE

  PICKUP_TRUCK
  SPORTS_CAR
  SUPERCAR
  HYPERCAR
  LIMOUSINE

  OTHER
}

model VehicleModelMaster {
  id        Int         @id @default(autoincrement())
  brandId   Int
  modelCode String      @unique
  modelName String
  bodyType  CarBodyType
  brand     BrandMaster @relation(fields: [brandId], references: [id])

  variants VehicleVariantMaster[]
  vehicles Vehicle[]
  fitment  PartFitment[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, modelCode]) // keep even with modelCode @unique; see note below
  @@index([brandId])
  @@map("VehicleModelMaster")
}

model VehicleVariantMaster {
  id          Int    @id @default(autoincrement())
  modelId     Int
  variantCode String
  variantName String

  model VehicleModelMaster @relation(fields: [modelId], references: [id])

  fuelType         String
  transmissionType String
  productionFrom   DateTime?
  productionTo     DateTime?

  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  vehicles  Vehicle[]
  fitment   PartFitment[]

  @@unique([modelId, fuelType, variantCode])
  @@index([modelId])
  @@map("VehicleVariantMaster")
}

model Tenant {
  id                 Int                 @id @default(autoincrement())
  tenantCode         String              @unique
  tenantName         String
  email              String              @unique
  phone              String?
  gstNumber          String?
  address            String?
  city               String?
  state              String?
  country            String?
  pincode            String?
  subscriptionPlan   SubscriptionPlan?
  subscriptionStatus SubscriptionStatus?
  isActive           Boolean             @default(true)

  createdBy Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  createdByUser PlatformUser @relation(fields: [createdBy], references: [id])

  users                          Users[]
  roles                          Role[]
  employeeDesignations           EmployeeDesignation[]
  branches                       Branch[]
  serviceCategoryMasters         ServiceCategoryMaster[]
  serviceTypes                   ServiceTypeMaster[]
  repairOrderType                RepairOrderTypeMaster[]
  customers                      Customer[]
  vehicles                       Vehicle[]
  jobCards                       JobCard[]
  labour                         LabourMaster[]
  dealerBayMasters               DealerBayMaster[]
  hsnMasters                     HSNMaster[]
  partCategory                   PartCategoryMaster[]
  parts                          PartMaster[]
  fitment                        PartFitment[]
  serviceQuotation               ServiceQuotationMaster[]
  serviceQuotationParts          ServiceQuotationPart[]
  serviceQuotationLabours        ServiceQuotationLabour[]
  serviceQuotationCustomerVoices ServiceQuotationCustomerVoice[]

  @@index([createdBy])
}

model Branch {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  branchCode String
  branchName String

  email String?
  phone String?

  address1 String?
  address2 String?
  locality String?
  city     String?
  state    String?
  country  String?
  pincode  String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant           Tenant                   @relation(fields: [tenantId], references: [id])
  users            Users[]
  jobCards         JobCard[]
  dealerBayMasters DealerBayMaster[]
  serviceQuotation ServiceQuotationMaster[]

  @@unique([tenantId, branchCode])
  @@index([tenantId])
}

model Users {
  id            Int       @id @default(autoincrement())
  tenantId      Int
  branchId      Int
  employeeCode  String
  roleId        Int
  designationId Int
  firstName     String
  middleName    String?
  lastName      String?
  email         String
  mobileNo      String
  passwordHash  String
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  branch      Branch              @relation(fields: [branchId], references: [id])
  role        Role                @relation(fields: [roleId], references: [id])
  designation EmployeeDesignation @relation(fields: [designationId], references: [id])

  authorizedCustomers Customer[]

  supervisedJobCards JobCard[]                @relation("JobCardSupervisor")
  technicianJobCards JobCard[]                @relation("JobCardTechnician")
  createdJobCards    JobCard[]                @relation("JobCardCreatedBy")
  jobCardAllocations JobCardAllocation[]      @relation("JobCardAllocationMechanic")
  serviceQuotation   ServiceQuotationMaster[]

  @@unique([tenantId, employeeCode])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([branchId])
  @@index([roleId])
  @@index([designationId])
}

model EmployeeDesignation {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  isMechanic  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant Tenant  @relation(fields: [tenantId], references: [id])
  users  Users[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Role {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  roleCode        String
  roleName        String
  roleDescription String?
  isSystemRole    Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  tenant             Tenant                  @relation(fields: [tenantId], references: [id])
  users              Users[]
  permissionMappings RolePermissionMapping[]

  @@unique([tenantId, roleCode])
  @@index([tenantId])
}

model Permission {
  id             Int      @id @default(autoincrement())
  permissionCode String   @unique
  permissionName String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  roleMappings RolePermissionMapping[]
}

model RolePermissionMapping {
  id           Int      @id @default(autoincrement())
  roleId       Int
  permissionId Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

enum ServiceCategoryMasterCode {
  PDI
  WARRANTY
  EXTENDED_WARRANTY
  POST_WARRANTY
  ACCIDENT
  IN_TRANSIT
}

model ServiceCategoryMaster {
  id          Int                       @id @default(autoincrement())
  tenantId    Int
  code        ServiceCategoryMasterCode @unique
  name        String
  description String?
  isActive    Boolean                   @default(true)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  tenant           Tenant                   @relation(fields: [tenantId], references: [id])
  serviceTypes     ServiceTypeMaster[]
  jobCards         JobCard[]
  serviceQuotation ServiceQuotationMaster[]

  @@map("ServiceCategoryMaster")
}

model ServiceTypeMaster {
  id Int @id @default(autoincrement())

  tenantId                Int
  serviceCategoryMasterId Int

  code        String
  name        String
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                Tenant                   @relation(fields: [tenantId], references: [id])
  serviceCategoryMaster ServiceCategoryMaster    @relation(fields: [serviceCategoryMasterId], references: [id])
  jobCards              JobCard[]
  serviceQuotation      ServiceQuotationMaster[]

  @@unique([tenantId, code])
  @@map("ServiceTypeMaster")
}

enum RepairType {
  QUICK_REPAIR
  MINOR_MECHANICAL
  MAJOR_MECHANICAL
  MINOR_ACCIDENTAL
  MAJOR_ACCIDENTAL
  SCHEDULE_MAINTENANCE
}

model RepairOrderTypeMaster {
  id Int @id @default(autoincrement())

  tenantId Int

  code        RepairType
  name        String
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant                   @relation(fields: [tenantId], references: [id])
  jobCards         JobCard[]
  serviceQuotation ServiceQuotationMaster[]

  @@unique([tenantId, code])
  @@map("RepairOrderTypeMaster")
}

model Customer {
  id Int @id @default(autoincrement())

  tenantId Int

  customerCode String

  title      String?
  firstName  String
  middleName String?
  lastName   String

  email             String?
  mobileNo          String
  alternateMobileNo String?

  dateOfBirth DateTime? @db.Date

  address1 String?
  address2 String?

  city    String?
  state   String?
  country String?
  pincode String?

  laborDiscountPercent Decimal @db.Decimal(5, 2)
  partDiscountPercent  Decimal @db.Decimal(5, 2)

  authorizedBy Int

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant                   @relation(fields: [tenantId], references: [id])
  authorizedByUser Users                    @relation(fields: [authorizedBy], references: [id])
  vehicles         Vehicle[]
  jobCards         JobCard[]
  serviceQuotation ServiceQuotationMaster[]

  @@unique([tenantId, customerCode])
  @@map("Customer")
}

model Vehicle {
  id Int @id @default(autoincrement())

  tenantId   Int
  customerId Int
  brandId    Int
  modelId    Int
  variantId  Int

  vehicleNumber String?
  chassisNumber String
  engineNumber  String

  color             String?
  manufacturingYear Int? // keep as year, not DateTime; see note below
  registrationDate  DateTime? @db.Date
  purchaseDate      DateTime? @db.Date

  currentOdometerReading Int
  vehicleInTime          DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  customer Customer             @relation(fields: [customerId], references: [id])
  brand    BrandMaster          @relation(fields: [brandId], references: [id])
  model    VehicleModelMaster   @relation(fields: [modelId], references: [id])
  variant  VehicleVariantMaster @relation(fields: [variantId], references: [id])

  jobCards         JobCard[]
  serviceQuotation ServiceQuotationMaster[]

  @@unique([tenantId, chassisNumber])
  @@unique([tenantId, engineNumber])
  @@index([tenantId, vehicleNumber])
  @@index([variantId])
  @@map("Vehicle")
}

enum JobCardStatus {
  OPEN
  CLOSED
}

enum JobCardVehicleStatus {
  MOBILIZE
  IMMOBILIZE
}

model JobCard {
  id Int @id @default(autoincrement())

  tenantId Int
  branchId Int

  jobCardNo String

  vehicleId         Int
  customerId        Int
  vehicleInTime     DateTime?
  currentKmReading  Int
  previousKmReading Int?

  vehicleStatus JobCardVehicleStatus

  supervisorId Int?
  technicianId Int?

  serviceCategoryId Int
  serviceTypeId     Int
  repairOrderTypeId Int

  isRevisit Boolean @default(false)

  estimateCloseAt        DateTime
  revisedEstimateCloseAt DateTime?
  closedAt               DateTime?

  status JobCardStatus @default(OPEN)

  driverName     String?
  driverMobileNo String?

  isBreakdown             Boolean   @default(false)
  breakdownPersonAttended String?
  breakdownDateTime       DateTime?
  breakdownStartDateTime  DateTime?
  breakdownEndDateTime    DateTime?
  dealerVanStartKm        Int?
  dealerVanEndKm          Int?

  createdBy Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  supervisor    Users? @relation("JobCardSupervisor", fields: [supervisorId], references: [id])
  technician    Users? @relation("JobCardTechnician", fields: [technicianId], references: [id])
  createdByUser Users  @relation("JobCardCreatedBy", fields: [createdBy], references: [id])

  serviceCategory       ServiceCategoryMaster  @relation(fields: [serviceCategoryId], references: [id])
  serviceType           ServiceTypeMaster      @relation(fields: [serviceTypeId], references: [id])
  repairOrderType       RepairOrderTypeMaster  @relation(fields: [repairOrderTypeId], references: [id])
  jobCardCustomerVoices JobCardCustomerVoice[]
  allocations           JobCardAllocation[]

  @@unique([tenantId, jobCardNo])
  @@index([tenantId, status])
  @@index([tenantId, branchId, status])
  @@map("JobCard")
}

model JobCardCustomerVoice {
  id Int @id @default(autoincrement())

  jobCardId                Int
  customerVoiceDescription String

  observation     String
  actionToBeTaken Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobCard JobCard      @relation(fields: [jobCardId], references: [id])
  labour  LabourMaster @relation(fields: [actionToBeTaken], references: [id])

  @@map("JobCardCustomerVoice")
}

model LabourMaster {
  id Int @id @default(autoincrement())

  tenantId Int

  labourCode        String
  labourName        String
  labourDescription String
  standardHours     Decimal @db.Decimal(6, 2)
  rate              Decimal @db.Decimal(10, 2)
  hsnId   Int?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  hsn HSNMaster? @relation(fields: [hsnId], references: [id])
  actionToBeTaken         JobCardCustomerVoice[]
  serviceQuotationLabours ServiceQuotationLabour[]

  @@unique([tenantId, labourCode])
  @@map("LabourMaster")
}

model DealerBayMaster {
  id Int @id @default(autoincrement())

  tenantId Int
  branchId Int

  bayCode     String
  bayName     String
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  jobCardAllocations JobCardAllocation[]

  @@unique([branchId, bayCode])
  @@map("DealerBayMaster")
}

model JobCardAllocation {
  id Int @id @default(autoincrement())

  jobCardId  Int
  mechanicId Int
  bayId      Int

  bayInDateTime DateTime
  bayOutTime    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobCard  JobCard         @relation(fields: [jobCardId], references: [id])
  mechanic Users           @relation("JobCardAllocationMechanic", fields: [mechanicId], references: [id])
  bay      DealerBayMaster @relation(fields: [bayId], references: [id])

  @@index([jobCardId])
  @@index([mechanicId])
  @@index([bayId])
  @@map("JobCardAllocation")
}

//HSN Master
model HSNMaster {
  id Int @id @default(autoincrement())

  tenantId Int

  hsnCode     String
  description String?
  taxRate     Decimal? @db.Decimal(5, 2)

  isActive Boolean @default(true)

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  parts     PartMaster[]
  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  labour    LabourMaster[]

  @@unique([tenantId, hsnCode])
  @@map("HSNMaster")
}

model PartCategoryMaster {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  parts  PartMaster[]

  @@unique([tenantId, code])
  @@map("PartCategoryMaster")
}

enum PartStatus {
  ACTIVE
  SUPERSEDED
  INACTIVE
}

enum UnitOfMeasure {
  EA
  PCS
  SET
  PAIR
  L
  ML
  KG
  G
  M
  BOX
  PACK
  KIT
}

model PartMaster {
  id       Int    @id @default(autoincrement())
  tenantId Int
  partNo   String

  partDescription String

  partCategoryId Int?
  hsnId          Int

  sellingPrice  Decimal       @db.Decimal(12, 2)
  landingPrice  Decimal?      @db.Decimal(12, 2)
  taxRate       Decimal       @db.Decimal(5, 2)
  unitOfMeasure UnitOfMeasure

  reorderLevel Int?
  isFastMoving Boolean @default(false)

  status         PartStatus @default(ACTIVE)
  supersededById Int?

  validFrom DateTime  @default(now())
  validTo   DateTime?

  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  category     PartCategoryMaster? @relation(fields: [partCategoryId], references: [id])
  hsn          HSNMaster           @relation(fields: [hsnId], references: [id])
  supersededBy PartMaster?         @relation("PartSupersession", fields: [supersededById], references: [id])
  supersedes   PartMaster[]        @relation("PartSupersession")

  fitments             PartFitment[]
  serviceQuotationPart ServiceQuotationPart[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([tenantId, partNo])
  @@index([tenantId, status])
  @@index([tenantId, partCategoryId])
  @@map("PartMaster")
}

model PartFitment {
  id       Int @id @default(autoincrement())
  tenantId Int
  partId   Int

  modelId   Int
  variantId Int
  brandId   Int

  quantity Decimal @default(1) @db.Decimal(10, 2)
  position String?

  isOem     Boolean   @default(true)
  validFrom DateTime  @default(now())
  validTo   DateTime?

  tenant    Tenant               @relation(fields: [tenantId], references: [id])
  part      PartMaster           @relation(fields: [partId], references: [id])
  model     VehicleModelMaster   @relation(fields: [modelId], references: [id])
  variant   VehicleVariantMaster @relation(fields: [variantId], references: [id])
  brand     BrandMaster          @relation(fields: [brandId], references: [id])
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([tenantId, variantId])
  @@index([tenantId, modelId])
  @@map("PartFitment")
}

enum Action {
  NEW
  SUPPLEMENT
}

enum serviceQuotationStatus {
  DRAFT
  INPROGRESS
  APPROVED
  COMPLETED
  GENERATED
  REJECTED
}

model ServiceQuotationMaster {
  id                   Int                      @id @default(autoincrement())
  tenantId             Int
  branchId             Int
  quotationNo          String
  originalQuotationId  Int?
  action               Action
  status               serviceQuotationStatus
  vehicleId            Int
  customerId           Int
  currentReading       Decimal                  @db.Decimal(8, 2)
  serviceCategoryId    Int
  serviceTypeId        Int
  repairOrderTypeId    Int
  insurancePartyName   String?
  partsBasicAmount     Decimal                  @db.Decimal(12, 2)
  partsDiscountAmount  Decimal                  @db.Decimal(12, 2)
  partsTaxAmount       Decimal                  @db.Decimal(12, 2)
  partsTotalAmount     Decimal                  @db.Decimal(12, 2)
  labourBasicAmount    Decimal                  @db.Decimal(12, 2)
  labourDiscountAmount Decimal                  @db.Decimal(12, 2)
  labourTaxAmount      Decimal                  @db.Decimal(12, 2)
  labourTotalAmount    Decimal                  @db.Decimal(12, 2)
  grandTotal           Decimal                  @db.Decimal(12, 2)
  closeAt              DateTime?
  createdBy            Int
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  tenant               Tenant                   @relation(fields: [tenantId], references: [id])
  branch               Branch                   @relation(fields: [branchId], references: [id])
  originalQuotation    ServiceQuotationMaster?  @relation("QuotationSupplement", fields: [originalQuotationId], references: [id])
  supplementQuotations ServiceQuotationMaster[] @relation("QuotationSupplement")
  vehicle              Vehicle                  @relation(fields: [vehicleId], references: [id])
  customer             Customer                 @relation(fields: [customerId], references: [id])
  serviceCategory      ServiceCategoryMaster    @relation(fields: [serviceCategoryId], references: [id])
  serviceType          ServiceTypeMaster        @relation(fields: [serviceTypeId], references: [id])
  repairOrderType      RepairOrderTypeMaster    @relation(fields: [repairOrderTypeId], references: [id])
  createdByEmployee    Users                    @relation(fields: [createdBy], references: [id])

  serviceQuotationParts          ServiceQuotationPart[]
  serviceQuotationLabours        ServiceQuotationLabour[]
  serviceQuotationCustomerVoices ServiceQuotationCustomerVoice[]

  @@unique([tenantId, quotationNo])
  @@index([tenantId, quotationNo])
  @@map("ServiceQuotation")
}

enum DiscountType {
  PERCENTAGE
  AMOUNT
}

model ServiceQuotationPart {
  id                 Int          @id @default(autoincrement())
  tenantId           Int
  serviceQuotationId Int
  //Part details Snapshot
  partId             Int
  partNo             String?
  partDescription    String?
  //Quantity and price
  quantity           Int
  rate               Decimal      @db.Decimal(12, 2)
  basicAmount        Decimal      @db.Decimal(12, 2)
  //Discount
  discountType       DiscountType
  discountRate       Decimal      @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal      @db.Decimal(12, 2)

  //Tax Snapshot
  hsnCode       String?
  taxRate       Decimal @db.Decimal(5, 2)
  taxableAmount Decimal @db.Decimal(12, 2)
  taxAmount     Decimal @default(0) @db.Decimal(12, 2)

  // Final line amount
  totalAmount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant                 @relation(fields: [tenantId], references: [id])
  serviceQuotation ServiceQuotationMaster @relation(fields: [serviceQuotationId], references: [id])
  parts            PartMaster             @relation(fields: [partId], references: [id])

  @@index([tenantId, serviceQuotationId])
  @@index([tenantId, partId])
  @@map("ServiceQuotationPart")
}

model ServiceQuotationLabour {
  id                 Int          @id @default(autoincrement())
  tenantId           Int
  serviceQuotationId Int
  //Part details Snapshot
  labourId           Int
  labourName         String?
  labourCode         String?
  labourDescription  String?
  //Quantity and price
  rate               Decimal      @db.Decimal(12, 2)
  basicAmount        Decimal      @db.Decimal(12, 2)
  //Discount
  discountType       DiscountType
  discountRate       Decimal      @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal      @db.Decimal(12, 2)

  //Tax Snapshot
  taxRate       Decimal @db.Decimal(5, 2)
  taxableAmount Decimal @db.Decimal(12, 2)
  taxAmount     Decimal @default(0) @db.Decimal(12, 2)

  // Final line amount
  totalAmount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant                 @relation(fields: [tenantId], references: [id])
  serviceQuotation ServiceQuotationMaster @relation(fields: [serviceQuotationId], references: [id])
  labours          LabourMaster           @relation(fields: [labourId], references: [id])

  @@index([tenantId, serviceQuotationId])
  @@index([tenantId, labourId])
  @@map("ServiceQuotationLabour")
}

enum Sources {
  CUSTOMER
  SERVICE_SUPERVISOR
  FORM_PREVIOUS_JOB_CARD
  TEST_DRIVE
}

model ServiceQuotationCustomerVoice {
  id                 Int      @id @default(autoincrement())
  tenantId           Int
  serviceQuotationId Int
  customerVoice      String
  source             Sources
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant           Tenant                 @relation(fields: [tenantId], references: [id])
  serviceQuotation ServiceQuotationMaster @relation(fields: [serviceQuotationId], references: [id])

  @@index([tenantId, serviceQuotationId])
  @@map("ServiceQuotationCustomerVoice")
}
